events {}

http {
    # Docker DNS — paired with $var in proxy_pass to force runtime re-resolution.
    resolver 127.0.0.11 valid=10s ipv6=off;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        '' close;
    }

    server {
        listen 443 ssl;
        server_name ${NGINX_SERVER_NAME};
        http2  on;
        default_type  application/octet-stream;
        add_header X-Content-Type-Options nosniff;
        add_header X-XSS-Protection "1; mode=block";

        ssl_certificate /etc/ssl/certs/fullchain.pem;
        ssl_certificate_key /etc/ssl/certs/privkey.pem;
        # Keep in sync with MAX_REQUEST_BODY_BYTES in core/constants.py (which also
        # drives Django's DATA_UPLOAD_MAX_MEMORY_SIZE). Oversized bodies answer with
        # the JSON 413 in @too_large so the SPA gets the same shape Django returns.
        client_max_body_size 50M;


        error_log /var/log/nginx/error.log debug;

        location /ws/ {
            set $upstream_ws codepost-api;
            proxy_pass http://$upstream_ws:8000;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_read_timeout 3600;
        }

        # MCP endpoint for instructor agents — its own single-process container.
        # Tool calls can be slow (autograder builds, fan-out reads), so it gets
        # the /ws/-style timeout and unbuffered responses (ready for SSE).
        location /mcp {
            set $upstream_mcp codepost-mcp;
            proxy_pass http://$upstream_mcp:8001;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_read_timeout 3600;
            proxy_buffering off;
            error_page 502 503 @api_unavailable;
            error_page 504 @api_timeout;
            error_page 413 @too_large;
        }

        # Dataset uploads (AssignmentDataSet.file, up to MAX_DATASET_SIZE = 1 GB in
        # core/constants.py). Scoped here so the 50M default above still protects every
        # other route; the body streams straight to uvicorn instead of spooling to disk.
        location /assignmentDataSets/ {
            set $upstream_datasets codepost-api;
            proxy_pass http://$upstream_datasets:8000;
            error_page 502 503 @api_unavailable;
            error_page 504 @api_timeout;
            error_page 413 @too_large;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            client_max_body_size 1G;
            proxy_read_timeout 3600;
            proxy_request_buffering off;
        }

        location / {
            # Let Django handle CORS - don't add CORS headers in nginx
            set $upstream codepost-api;
            proxy_pass http://$upstream:8000;
            error_page 502 503 @api_unavailable;
            error_page 504 @api_timeout;
            error_page 413 @too_large;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # When the API container is down or restarting, answer with JSON + CORS instead
        # of nginx's HTML 502: the cross-origin SPA can then tell "API down" (a readable
        # 503) from "no network" (an opaque error) and show one banner + retry. Only
        # errors nginx generates itself land here (proxy_intercept_errors stays off), so
        # a 503 the API produces passes through with Django's own CORS headers.
        location @api_unavailable {
            default_type application/json;
            add_header Access-Control-Allow-Origin $http_origin always;
            add_header Access-Control-Allow-Credentials true always;
            add_header Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS" always;
            add_header Access-Control-Allow-Headers "Authorization, Content-Type, X-CSRFToken, X-Requested-With" always;
            add_header Vary Origin always;
            add_header Retry-After 10 always;
            if ($request_method = OPTIONS) { return 204; }
            return 503 '{"detail": "codePost API is temporarily unavailable. Please retry shortly."}';
        }

        # Upstream took longer than proxy_read_timeout (slow AI call, big export). Not an
        # outage: say so, and don't send Retry-After so the SPA doesn't auto-retry a paid call.
        location @api_timeout {
            default_type application/json;
            add_header Access-Control-Allow-Origin $http_origin always;
            add_header Access-Control-Allow-Credentials true always;
            add_header Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS" always;
            add_header Access-Control-Allow-Headers "Authorization, Content-Type, X-CSRFToken, X-Requested-With" always;
            add_header Vary Origin always;
            return 504 '{"detail": "The request took too long to complete. Please try again; if it keeps happening, contact support."}';
        }

        # Body over client_max_body_size: JSON + CORS instead of nginx's HTML 413, matching
        # core/exceptions.py so the SPA shows one "upload too large" message either way.
        location @too_large {
            default_type application/json;
            add_header Access-Control-Allow-Origin $http_origin always;
            add_header Access-Control-Allow-Credentials true always;
            add_header Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS" always;
            add_header Access-Control-Allow-Headers "Authorization, Content-Type, X-CSRFToken, X-Requested-With" always;
            add_header Vary Origin always;
            return 413 '{"detail": "Upload too large: a single request may not exceed 50 MB."}';
        }
    }
     server {
        listen 80;
        server_name ${NGINX_SERVER_NAME};
        return 301 https://$host$request_uri;
    }
}
