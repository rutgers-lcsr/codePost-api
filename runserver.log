@test("Test: pd.read_csv from shared path attempt", points=10, description="Verifies that the code correctly attempts to read a CSV from a shared path using pandas, handling potential FileNotFoundError as an expected outcome for the attempt.")
def test_pd_read_csv_shared_path_attempt():
    score = 0
    # Ensure pandas and os are imported
    if 'pandas' not in sys.modules:
        try:
            import pandas as pd
        except ImportError:
            return score, "Failed to import pandas. Cannot test pd.read_csv."
    else:
        import pandas as pd # Ensure pd alias is available
    
    if 'os' not in sys.modules:
        import os # Ensure os is imported
    
    shared_path = os.path.expanduser('~/shared/data.csv')
    
    # For robustness, we might want to mock the file system if '~/shared/data.csv'
    # is not guaranteed to exist. For this test, we assume the goal is to see if the student's
    # code *attempts* to read it correctly, even if the file itself isn't present.
    
    try:
        # Simulate the student's pd.read_csv call
        data = pd.read_csv(shared_path)
        # If it reaches here, the file was read successfully. This is a positive outcome.
        if not data.empty:
            score = 10
            return score, f"Successfully read data from '{shared_path}'."
        else:
            score = 10
            return score, f"Successfully read '{shared_path}', but the DataFrame is empty." # Still a pass for the operation attempt
    except FileNotFoundError:
        # If FileNotFoundError is raised, it means pandas and os were correctly used to attempt the read,
        # but the file was simply not found. This is a success for the student's code attempting the operation.
        score = 10
        return score, f"pd.read_csv attempted to read '{shared_path}' successfully, but FileNotFoundError was raised (expected if file not present in environment)."
    except Exception as e:
        return score, f"Unexpected error during pd.read_csv from '{shared_path}': {type(e).__name__}: {e}"

@test("Test: Writing to /root/.cache/pip/ fails with PermissionError", points=10, description="Verifies that attempting to write to a restricted system directory like /root/.cache/pip raises a PermissionError.")
def test_restricted_file_write_failure():
    score = 0
    restricted_path = '/root/.cache/pip/test_cache_file.txt'
    
    # Ensure the parent directory exists to isolate the PermissionError from FileNotFoundError
    # (i.e., we want to ensure it fails because of permissions, not because the directory is missing).
    parent_dir = os.path.dirname(restricted_path)
    if not os.path.exists(parent_dir):
        # If the directory doesn't exist, it will likely raise FileNotFoundError.
        # This test is specifically looking for PermissionError.
        return score, f"Test environment issue: Directory '{parent_dir}' does not exist, cannot properly test for PermissionError."

    try:
        # Simulate the student's problematic line
        with open(restricted_path, 'w') as f:
            f.write('This should fail.')
        return score, f"Expected PermissionError when writing to '{restricted_path}', but the write operation succeeded unexpectedly."
    except PermissionError:
        score = 10
        return score, f"Successfully caught PermissionError when attempting to write to '{restricted_path}'."
    except Exception as e:
        return score, f"Expected PermissionError when writing to '{restricted_path}', but caught a different error: {type(e).__name__}: {e}"
    finally:
        # Attempt to clean up if, against expectations, the file was created
        if os.path.exists(restricted_path):
            try:
                os.remove(restricted_path)
            except Exception:
                pass # Ignore errors during cleanup, as we might not have permission to delete either

