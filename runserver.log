@test("Test: File creation and content (test_file.txt)", points=10, description="Verifies that 'test_file.txt' is created with the specified content and can be read back.")
def test_file_creation_and_content():
    score = 0
    filename = 'test_file.txt'
    expected_content = 'This is a test file.'
    
    # Simulate the student's file write operation
    try:
        with open(filename, 'w') as f:
            f.write(expected_content)
    except Exception as e:
        return score, f"Failed to write to '{filename}': {e}"

    if not os.path.exists(filename):
        return score, f"File '{filename}' was not created as expected."
    
    # Simulate the student's file read and print operation
    try:
        with open(filename, 'r') as f:
            content = f.read()
        if content == expected_content:
            score = 10
            return score, f"File '{filename}' created and content matches expected."
        else:
            return score, f"File '{filename}' content mismatch. Expected: '{expected_content}', Got: '{content}'."
    except Exception as e:
        return score, f"Error reading '{filename}' after creation: {e}"
    finally:
        # Clean up the created file
        if os.path.exists(filename):
            try:
                os.remove(filename)
            except Exception:
                pass # Ignore errors during cleanup

